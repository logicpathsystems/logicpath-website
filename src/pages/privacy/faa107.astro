    .legal-content h3 {
        color: var(--text-primary);
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
    }

    .legal-content p, .legal-content ul {
        color: var(--text-secondary);
        margin-bottom: 1.25rem;
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .legal-content ul {
        padding-left: 2rem;
        margin-bottom: 2rem;
    }

    .legal-content li {
        margin-bottom: 0.5rem;
    }
</style>
